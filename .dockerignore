# Root build context for docker/backend and docker/frontend Dockerfiles.
# Keep the context small; app code is bind-mounted in Compose, not baked in for Day 1–3.
.git
.github
.env
.env.*
!.env.example
backend/vendor
backend/.env
backend/storage/logs
backend/.phpunit.result.cache
frontend/node_modules
frontend/.next
frontend/.env
**/*.log
**/coverage
docs
scripts
