APP_NAME="Outdoor Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=outdoor_commerce
DB_USERNAME=outdoor
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Local HTTP: false. Production HTTPS: true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Day 9 media (local disks media_private / media_public)
MEDIA_QUEUE=media
MEDIA_MAX_FILE_SIZE_KB=15360
MEDIA_MAX_FILES_PER_REQUEST=10
MEDIA_MAX_PRODUCT_GALLERY=20
MEDIA_MAX_VARIANT_GALLERY=10
MEDIA_AVIF_ENABLED=false
MEDIA_ORPHAN_GRACE_HOURS=24

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=masterKey_change_me
MEILISEARCH_KEY=masterKey_change_me
MEILISEARCH_INDEX_PREFIX=outdoor_local
MEILISEARCH_CONNECT_TIMEOUT=0.4
MEILISEARCH_REQUEST_TIMEOUT=1.5
SEARCH_ENABLED=true
SEARCH_FALLBACK_ENABLED=true
SEARCH_DEFAULT_LOCALE=ka
SPECIES_DEFAULT_LOCALE=ka
SPECIES_FALLBACK_LOCALE=ka
SPECIES_ENGLISH_FALLBACK=true
SPECIES_REQUIRE_DISTINCT_REVIEWER=false
SPECIES_CACHE_TTL=300
SPECIES_PUBLIC_PER_MINUTE=120
SPECIES_LIST_PER_MINUTE=60

CART_CURRENCY=GEL
CART_MAX_LINE_QUANTITY=12
CART_MAX_UNIQUE_LINES=50
CART_GUEST_TTL_DAYS=30
CART_AUTHENTICATED_TTL_DAYS=90
CART_IDEMPOTENCY_TTL_HOURS=24
CART_COOKIE_NAME=outdoor_guest_cart
CART_COOKIE_SECURE=false
CART_COOKIE_SAME_SITE=lax

CHECKOUT_CURRENCY=GEL
CHECKOUT_DEFAULT_COUNTRY=GE
CHECKOUT_PRICE_INCLUDES_TAX=true
CHECKOUT_QUOTE_TTL_MINUTES=15
CHECKOUT_SESSION_TTL_HOURS=24
CHECKOUT_MAX_ACTIVE_SESSIONS=3
CHECKOUT_MAX_QUOTE_REFRESHES=8
CHECKOUT_MAX_LINE_QUANTITY=12
CHECKOUT_IDEMPOTENCY_TTL_HOURS=24
CHECKOUT_READ_PER_MINUTE=30
CHECKOUT_MUTATE_PER_MINUTE=20
CHECKOUT_QUOTE_PER_MINUTE=8

ORDER_CURRENCY=GEL
ORDER_NUMBER_PREFIX=ORD
ORDER_NUMBER_SUFFIX_LENGTH=6
ORDER_PENDING_PAYMENT_TTL_MINUTES=20
ORDER_IDEMPOTENCY_TTL_HOURS=24
ORDER_EXPIRE_CHUNK_SIZE=100
ORDER_GUEST_ACCESS_TTL_DAYS=30
ORDER_COOKIE_NAME=outdoor_guest_order
ORDER_COOKIE_SECURE=false
ORDER_COOKIE_SAME_SITE=lax
ORDER_READ_PER_MINUTE=30
ORDER_CREATE_PER_MINUTE=8
ORDER_CANCEL_PER_MINUTE=8

PAYMENT_TEST_PROVIDER_ENABLED=true
PAYMENT_TEST_WEBHOOK_SECRET=test-payment-webhook-secret-change-me
PAYMENT_TEST_SCENARIO=success
PAYMENT_CURRENCY=GEL
PAYMENT_IDEMPOTENCY_TTL_HOURS=24
PAYMENT_WEBHOOK_MAX_BYTES=65536
PAYMENT_WEBHOOK_TIMESTAMP_TOLERANCE=300
PAYMENT_RECONCILE_CHUNK_SIZE=50
PAYMENT_RECONCILE_MIN_AGE_SECONDS=30
PAYMENT_PROVIDER_CONNECT_TIMEOUT=2
PAYMENT_PROVIDER_REQUEST_TIMEOUT=8
PAYMENT_ALLOWED_REDIRECT_HOSTS=localhost,127.0.0.1,payments.test
PAYMENT_HTTPS_REQUIRED=false
PAYMENT_METHODS_PER_MINUTE=30
PAYMENT_MUTATE_PER_MINUTE=10
PAYMENT_READ_PER_MINUTE=30
PAYMENT_WEBHOOK_PER_MINUTE=120

# Bank of Georgia Payment Manager (Day 21). Disabled until merchant credentials exist.
# Official docs reviewed 2026-09-23: https://api.bog.ge/docs/en/payments/introduction
# Do not use deprecated iPay (https://ipay.ge/opay/api/v1).
BOG_PAYMENT_ENABLED=false
BOG_PAYMENT_ENVIRONMENT=test
BOG_PAYMENT_CLIENT_ID=
BOG_PAYMENT_CLIENT_SECRET=
BOG_PAYMENT_OAUTH_URL=https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token
BOG_PAYMENT_API_BASE_URL=https://api.bog.ge/payments/v1
BOG_PAYMENT_CALLBACK_PUBLIC_KEY=
BOG_PAYMENT_CALLBACK_PUBLIC_KEY_PATH=
BOG_PAYMENT_CALLBACK_PUBLIC_KEY_PREVIOUS=
BOG_PAYMENT_CALLBACK_URL="${APP_URL}/api/v1/payments/webhooks/bog"
BOG_PAYMENT_SUCCESS_URL="${FRONTEND_URL}/payment/return"
BOG_PAYMENT_FAILURE_URL="${FRONTEND_URL}/payment/return"
BOG_PAYMENT_CONNECT_TIMEOUT_SECONDS=5
BOG_PAYMENT_REQUEST_TIMEOUT_SECONDS=15
BOG_PAYMENT_TOKEN_REFRESH_SKEW_SECONDS=60
BOG_PAYMENT_DEFAULT_TTL_MINUTES=15
BOG_PAYMENT_TTL_SAFETY_MARGIN_MINUTES=1
BOG_PAYMENT_ALLOWED_METHODS=card
BOG_PAYMENT_THEME=dark
BOG_PAYMENT_ACCOUNT_TAG=
BOG_PAYMENT_ALLOWED_REDIRECT_HOSTS=payment.bog.ge

# Day 22 fulfillment / shipments. Manual provider only — no courier API.
SHIPMENT_NUMBER_PREFIX=SHP
SHIPMENT_MANUAL_PROVIDER_ENABLED=true
SHIPMENT_HTTPS_REQUIRED=
SHIPMENT_ALLOWED_TRACKING_HOSTS=tracking.example.com
SHIPMENT_ADMIN_READ_PER_MINUTE=60
SHIPMENT_ADMIN_MUTATE_PER_MINUTE=30
SHIPMENT_CUSTOMER_READ_PER_MINUTE=30
SHIPMENT_WEBHOOK_PER_MINUTE=120
SHIPMENT_STALE_PREPARING_MINUTES=1440
SHIPMENT_STALE_READY_FOR_DISPATCH_MINUTES=720
SHIPMENT_STALE_SHIPPED_MINUTES=10080
SHIPMENT_STALE_EXCEPTION_MINUTES=2880
SHIPMENT_STALE_READY_FOR_PICKUP_MINUTES=10080

# Day 25 legal sources (private local disk, never public URLs)
LEGAL_DEFAULT_JURISDICTION=GE
LEGAL_TIMEZONE=Asia/Tbilisi
LEGAL_REQUIRE_DISTINCT_PUBLISHER=false
LEGAL_STORAGE_DISK=legal_private
LEGAL_MAX_FILE_KB=20480
LEGAL_URL_RETRIEVAL_ENABLED=true
LEGAL_CACHE_TTL=120
LEGAL_SEARCH_ENABLED=false
LEGAL_PUBLIC_PER_MINUTE=60
LEGAL_EVALUATE_PER_MINUTE=20
LEGAL_ADMIN_DOWNLOAD_PER_MINUTE=30
LEGAL_CALENDAR_PER_MINUTE=30
LEGAL_CALENDAR_MAX_PUBLIC_DAYS=366
LEGAL_CALENDAR_HORIZON_PAST=1
LEGAL_CALENDAR_HORIZON_FUTURE=3

VITE_APP_NAME="${APP_NAME}"
