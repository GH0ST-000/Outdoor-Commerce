<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!-- force=false allows CI to inject MySQL + Redis -->
        <env name="CACHE_STORE" value="array" force="false"/>
        <env name="DB_CONNECTION" value="sqlite" force="false"/>
        <env name="DB_DATABASE" value=":memory:" force="false"/>
        <env name="DB_URL" value="" force="false"/>
        <env name="DB_HOST" value="127.0.0.1" force="false"/>
        <env name="DB_PORT" value="3306" force="false"/>
        <env name="DB_USERNAME" value="root" force="false"/>
        <env name="DB_PASSWORD" value="" force="false"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="false"/>
        <env name="SESSION_DRIVER" value="array" force="false"/>
        <env name="FILESYSTEM_DISK" value="local" force="true"/>
        <env name="REDIS_CLIENT" value="phpredis" force="false"/>
        <env name="REDIS_HOST" value="127.0.0.1" force="false"/>
        <env name="REDIS_PORT" value="6379" force="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
