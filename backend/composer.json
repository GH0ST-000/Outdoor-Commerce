{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "intervention/image": "^3.0",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "meilisearch/meilisearch-php": "^1.15",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@putenv PAO_DISABLE=true",
            "@php -r \"is_dir('storage/logs') || mkdir('storage/logs', 0775, true);\"",
            "@php vendor/bin/pest --parallel --recreate-databases --log-junit=storage/logs/junit.xml"
        ],
        "test:sequential": [
            "@php artisan config:clear --ansi",
            "@putenv PAO_DISABLE=true",
            "@php -r \"is_dir('storage/logs') || mkdir('storage/logs', 0775, true);\"",
            "@php vendor/bin/pest --log-junit=storage/logs/junit.xml"
        ],
        "test:architecture": [
            "@putenv PAO_DISABLE=true",
            "@php vendor/bin/pest --testsuite=Architecture"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "format": [
            "@putenv PAO_DISABLE=true",
            "@php vendor/bin/pint"
        ],
        "format:check": [
            "@putenv PAO_DISABLE=true",
            "@php vendor/bin/pint --test"
        ],
        "analyse": [
            "@putenv PAO_DISABLE=true",
            "@putenv XDEBUG_MODE=off",
            "@php vendor/bin/phpstan analyse --memory-limit=1G --debug"
        ],
        "quality": [
            "@format:check",
            "@analyse",
            "@test:architecture",
            "@test"
        ],
        "ci": [
            "composer validate --strict --no-check-publish --no-interaction",
            "@format:check",
            "@analyse",
            "@test:architecture",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
