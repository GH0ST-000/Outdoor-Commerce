# Application
APP_NAME="Outdoor Commerce"
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# Public URLs (host machine)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
BACKEND_INTERNAL_URL=http://backend:8000

# Published ports
FRONTEND_PUBLISH_PORT=3000
BACKEND_PUBLISH_PORT=8000
MYSQL_PUBLISH_PORT=3306
REDIS_PUBLISH_PORT=6379
MEILI_PUBLISH_PORT=7700
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# MySQL (local defaults — replace in production)
MYSQL_DATABASE=outdoor_commerce
MYSQL_USER=outdoor
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

# Redis
REDIS_PASSWORD=

# Meilisearch (server-only master key — never expose to the browser)
MEILI_MASTER_KEY=masterKey_change_me

# Host user mapping for non-root containers (optional on macOS Docker Desktop)
HOST_UID=1000
HOST_GID=1000

# Next.js file watching inside Docker (useful on some platforms)
WATCHPACK_POLLING=true
