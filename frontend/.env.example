# Public (safe for the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side catalog fallback. The browser uses same-origin /api and /sanctum
# (rewritten by next.config to 127.0.0.1:8000) so Sanctum cookies work.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Day 17 Cart. Laravel is authoritative; keep true in local and production once Day 17 is deployed.
NEXT_PUBLIC_CART_ENABLED=true

# Public legal map (Day 28). The token, if set, must be a public token restricted
# by domain at the provider. Do not put a secret key here.
# Leave the style URL empty in development to use the OpenFreeMap Liberty fallback.
# Set both in production. Do not point production at the public OSM raster servers.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.example.com/styles/outdoor/style.json
# NEXT_PUBLIC_MAP_TOKEN=
# NEXT_PUBLIC_MAP_CENTER_LNG=43.5
# NEXT_PUBLIC_MAP_CENTER_LAT=42.2
# NEXT_PUBLIC_MAP_ZOOM=6.5
# NEXT_PUBLIC_MAP_MIN_ZOOM=5
# NEXT_PUBLIC_MAP_MAX_ZOOM=16
# NEXT_PUBLIC_MAP_BOUNDS=39.9,41.0,46.8,43.6

# Server-only (never expose to the browser).
# Docker Compose sets this to http://backend:8000. Omit it for host `next dev`.
# BACKEND_INTERNAL_URL=http://backend:8000
NODE_ENV=development
