# Public (safe for the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Day 17 Cart. Keep false so the product page cannot persist a fake cart.
NEXT_PUBLIC_CART_ENABLED=false

# Server-only (never expose to the browser).
# Docker Compose uses the service hostname. Host `next dev` falls back to NEXT_PUBLIC_API_URL.
BACKEND_INTERNAL_URL=http://backend:8000
NODE_ENV=development
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
