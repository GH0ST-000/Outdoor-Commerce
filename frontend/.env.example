# Public (safe for the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use 127.0.0.1 (not localhost) so Node/browser do not hit Docker's IPv6 :8000.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
# Day 17 Cart. Keep false so the product page cannot persist a fake cart.
NEXT_PUBLIC_CART_ENABLED=false

# Server-only (never expose to the browser).
# Docker Compose sets this to http://backend:8000. Omit it for host `next dev`.
# BACKEND_INTERNAL_URL=http://backend:8000
NODE_ENV=development
